# Somente os NOMES das variáveis. Nunca coloque valores reais neste arquivo.
# Preencha os valores direto no painel da hospedagem (Vercel, Abacus, etc.).

# Banco de dados (Neon / PostgreSQL)
DATABASE_URL=

# URL pública do app. Troque ao mudar de hospedagem ou de domínio.
# Usada nos links de recuperação de senha e nos retornos do Stripe.
NEXTAUTH_URL=

# Autenticação
NEXTAUTH_SECRET=
AUTH_SECRET=

# IA (Google AI Studio)
GOOGLE_AI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_30=
STRIPE_PRICE_CREDITS_40=

# E-mail (Resend)
RESEND_API_KEY=

# Admin
ADMIN_SETUP_SECRET=

# Notificações push (Web Push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Protege a rota /api/cron/push-daily (enviada como "Authorization: Bearer ...")
CRON_SECRET=
